{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{data,public}/**"
    },
    "api/index.js": {
      "includeFiles": "{data,public}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js?__path=:path*" },
    { "source": "/api", "destination": "/api/index.js?__path=" },
    { "source": "/thumb:path*", "destination": "/api/index.js?__path=thumb:path*" },
    { "source": "/studio/editor", "destination": "/editor.html" },
    { "source": "/studio/client", "destination": "/client.html" },
    { "source": "/wedding/editor", "destination": "/editor.html" },
    { "source": "/wedding/client", "destination": "/client.html" },
    { "source": "/editor", "destination": "/editor.html" },
    { "source": "/client", "destination": "/client.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
